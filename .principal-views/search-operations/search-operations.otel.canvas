{
  "name": "Search Operations",
  "markdown": ".principal-views/search-operations.md",
  "description": "OpenTelemetry event schema for cross-entity search initialization, querying, and index updates",
  "edgeTypes": {
    "flow": {
      "label": "Flow",
      "style": "solid",
      "width": 2,
      "color": "#64748b"
    },
    "error": {
      "label": "Error Path",
      "style": "dashed",
      "width": 2,
      "color": "#ef4444"
    }
  },
  "nodeTypes": {
    "event": {
      "label": "Event",
      "color": "#3B82F6"
    }
  },
  "nodes": [
    {
      "id": "search-initialize-started",
      "type": "otel-event",
      "x": 100,
      "y": 50,
      "width": 240,
      "height": 110,
      "color": "#22c55e",
      "label": "Initialize Started",
      "fill": "#22c55e",
      "shape": "rectangle",
      "event": {
        "name": "search.initialize.started",
        "attributes": {
          "operation": {
            "type": "string",
            "required": true
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/core/search-service.ts"
        ],
        "scope": "backlog.md"
      }
    },
    {
      "id": "search-initialize-snapshot",
      "type": "otel-event",
      "x": 100,
      "y": 200,
      "width": 240,
      "height": 110,
      "color": "#3b82f6",
      "label": "Initialize Snapshot",
      "fill": "#3b82f6",
      "shape": "rectangle",
      "event": {
        "name": "search.initialize.snapshot",
        "attributes": {
          "taskCount": {
            "type": "number",
            "required": true
          },
          "documentCount": {
            "type": "number",
            "required": true
          },
          "decisionCount": {
            "type": "number",
            "required": true
          }
