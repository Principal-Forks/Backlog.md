{
  "name": "Backlog Init",
  "markdown": ".principal-views/init/init.md",
  "description": "CLI command for initializing a new Backlog.md workspace",
  "edgeTypes": {
    "flow": {
      "label": "Flow",
      "style": "solid",
      "width": 2,
      "color": "#64748b"
