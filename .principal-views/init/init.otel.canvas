    "event": {
      "label": "Event",
      "color": "#3B82F6"
    }
  },
  "nodes": [
    {
      "id": "init-started",
      "type": "otel-event",
      "x": 100,
      "y": 50,
      "width": 200,
      "height": 100,
      "label": "Init Started",
      "shape": "rectangle",
      "event": {
        "name": "init.started",
        "attributes": {
          "projectName": {
            "type": "string",
            "required": true
          },
          "integrationMode": {
            "type": "string",
            "required": true
          },
          "isReInitialization": {
            "type": "boolean",
            "required": true
          },
          "mcpClients": {
            "type": "array",
            "required": false
          },
          "hasAdvancedConfig": {
            "type": "boolean",
            "required": false
          }
        }
      },
      "otel": {
        "status": "implemented",
        "files": [
          "src/core/init.ts"
        ],
        "scope": "backlog.md"
      }
    },
    {
