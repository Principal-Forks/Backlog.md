  "edges": [
    {
      "id": "invoked-validated",
      "fromNode": "mcp-tool-invoked",
      "fromSide": "bottom",
      "toNode": "mcp-tool-validated",
      "toSide": "top",
      "edgeType": "flow"
    },
    {
      "id": "validated-dispatched",
      "fromNode": "mcp-tool-validated",
      "fromSide": "bottom",
      "toNode": "mcp-operation-dispatched",
      "toSide": "top",
      "edgeType": "flow"
    },
    {
      "id": "dispatched-response",
      "fromNode": "mcp-operation-dispatched",
      "fromSide": "bottom",
      "toNode": "mcp-tool-response",
      "toSide": "top",
      "edgeType": "flow"
    },
    {
      "id": "invoked-error",
      "fromNode": "mcp-tool-invoked",
      "fromSide": "right",
      "toNode": "mcp-tool-error",
      "toSide": "top",
      "edgeType": "error"
    }
  ]
