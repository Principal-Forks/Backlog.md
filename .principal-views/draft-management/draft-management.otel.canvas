{
  "name": "Draft Management",
  "markdown": ".principal-views/draft-management.md",
  "description": "Comprehensive draft management operations including create, view, list, promote, and archive",
  "edgeTypes": {
    "flow": {
      "label": "Flow",
      "style": "solid",
      "width": 2,
      "color": "#64748b"
    },
    "error": {
      "label": "Error Path",
      "style": "dashed",
      "width": 2,
      "color": "#ef4444"
    },
    "child-span": {
      "label": "Creates Child Span",
      "style": "dashed",
      "width": 2,
      "color": "#8b5cf6"
    }
  },
  "nodeTypes": {
    "event": {
      "label": "Event",
      "color": "#3B82F6"
    }
  },
  "nodes": [
